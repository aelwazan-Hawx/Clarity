# Database connection string (from Supabase or any PostgreSQL provider)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# JWT secret key — use any long random string
JWT_SECRET=your_super_secret_jwt_key_here

# Server port (Render sets this automatically)
PORT=5000

# Set to "production" when deploying
NODE_ENV=production
